# Build context excludes for `docker build` (see top-level Dockerfile).
.git
.github
.devcontainer
.secrets
docs
README.md
CLAUDE.md

# Node (app runtime): the devcontainer build never needs these, and
# node_modules alone would bloat its build context. app.Dockerfile's own
# build uses app.Dockerfile.dockerignore instead.
node_modules
dist
