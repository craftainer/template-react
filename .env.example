# Copy to .env and adjust for your setup; see README.md's "Connecting to
# the backend" and docs/adrs/0007-adopt-craftainer-bff.md.
#
# Only Vite reads this file (vite.config.ts). The dev BFF reads real
# environment variables instead: in the devcontainer they come from
# .devcontainer/compose.instance.yml.

# Where the Vite dev server proxies /bff, /api and /.well-known to: the dev
# BFF (`pnpm dev:bff`). Defaults to http://localhost:8787. The BFF itself
# reaches the backend through BFF_UPSTREAMS.
# VITE_BFF_PROXY_TARGET=http://localhost:8787

# The dev BFF's environment, when you run `pnpm dev:bff` outside the
# devcontainer (placeholders; the secret is template-fastapi's dev-only one).
# Export these in your shell; Vite does not read them.
# PUBLIC_ORIGIN=http://localhost:5173
# OIDC_ISSUER=http://localhost:8080/realms/template-fastapi
# OIDC_CLIENT_SECRET=dev-only-bff-client-secret
# OIDC_ALLOW_INSECURE=true
# SESSION_STORE_URL=redis://localhost:6379
# SESSION_STORE_ALLOW_PLAINTEXT=true
# BFF_PORT=8787
# BFF_UPSTREAMS={"crud":{"url":"http://localhost:8000","audience":"api","methods":["GET","POST","PUT","PATCH","DELETE"]}}
