{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "pre-commit": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "patch and minor updates",
      "automerge": true,
      "description": "Automerged updates wait 3 days after release (the age Renovate's own security:minimumReleaseAgeNpm preset uses), so a hijacked release is usually yanked or flagged before it lands in main. The top-level internalChecksFilter strict (the docs' recommendation with minimumReleaseAge) makes a still-pending version be skipped, not merged.",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The python-version datasource has no release timestamps, so under the default minimumReleaseAgeBehaviour (timestamp-required) a Python patch would stay pending forever. It is raised without the age check and, since nothing vouches for its age, is not automerged.",
      "matchDatasources": ["python-version"],
      "matchDepNames": ["python"],
      "groupName": "python patch",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false
    },
    {
      "description": "The github-runners datasource has no release timestamps either, so the 3 day age check would keep a runner image bump pending forever. Raised without the age check and not automerged.",
      "matchDatasources": ["github-runners"],
      "groupName": "runner images",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "major updates"
    },
    {
      "description": "A Python minor (3.14 -> 3.15) is a runtime upgrade for every instance that runs Python as its app runtime: its own runtime Dockerfile must move in step, and its tools must support the new version. Keep it out of the automerged group, as its own PR for manual review.",
      "matchDatasources": ["python-version"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "groupName": "python minor upgrade",
      "automerge": false
    },
    {
      "description": "Pin container images to their digest. Scoped to the docker managers on purpose: a global pinDigests also hits the pre-commit manager, whose tag revs can't be converted to digests (the update fails). GitHub Actions are pinned by helpers:pinGitHubActionDigests instead.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "description": "Renovate can't regenerate .devcontainer/devcontainer-lock.json, so features are bumped by hand together with it (see .devcontainer/README.md).",
      "matchManagers": ["devcontainer"],
      "matchDepTypes": ["feature"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^\\.devcontainer/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\nARG \\w+_VERSION=(?<currentValue>.*)\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/develop\\.d/.*\\.sh$/",
        "/^scripts/post-create\\.d/.*\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\n[A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\n\\w+_VERSION := (?<currentValue>.*)\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\n\\s*(?:runs-on|runner): \\$\\{\\{ vars\\.[A-Z0-9_]+ \\|\\| '(?<currentValue>[^']+)' \\}\\}"
      ]
    },
    {
      "description": "Pinned tool versions in the image-release Makefile and image.mk.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^image\\.mk$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\n[A-Z0-9_]+_VERSION\\s*:?=\\s*(?<currentValue>\\S+)"
      ]
    },
    {
      "description": "The skopeo image pinned by tag and digest in the Makefile; Renovate updates both.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "SKOPEO_IMAGE := quay\\.io/skopeo/stable:(?<currentValue>v[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/skopeo/stable"
    },
    {
      "description": "The syft image pinned by tag and digest in the Makefile; Renovate updates both.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "SYFT_IMAGE := anchore/syft:(?<currentValue>v[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "anchore/syft"
    },
    {
      "description": "The hadolint image pinned in the hadolint hook.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "entry: hadolint/hadolint:(?<currentValue>\\S+) hadolint"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "hadolint/hadolint"
    },
    {
      "description": "The Trivy image pinned by tag and digest in scripts/image-scan.sh; Renovate updates both.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/image-scan\\.sh$/"
      ],
      "matchStrings": [
        "trivy=aquasec/trivy:(?<currentValue>[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "aquasec/trivy"
    },
    {
      "description": "The ZAP image pinned by tag and digest in scripts/image-dast.sh; Renovate updates both.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/image-dast\\.sh$/"
      ],
      "matchStrings": [
        "zap=ghcr\\.io/zaproxy/zaproxy:(?<currentValue>[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/zaproxy/zaproxy"
    }
  ]
}
