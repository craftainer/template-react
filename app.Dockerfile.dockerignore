# Build context excludes for `docker build -f app.Dockerfile` (see
# app.Dockerfile). BuildKit reads this file *instead of* .dockerignore for
# that build, so it repeats every exclusion the runtime build needs.
.git
.github
.devcontainer
.secrets
.vscode
.claude
docs
README.md
CLAUDE.md

# The builder stage runs its own `pnpm install`/`pnpm build` -- without
# these, `COPY . .` (after that install) would overwrite the container's
# own node_modules with the host's, which may not match its platform/arch.
node_modules
dist
coverage
