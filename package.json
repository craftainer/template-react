{
  "name": "template-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "dev:bff": "pnpm --filter ./bff dev",
    "start:bff": "pnpm --filter ./bff start",
    "typecheck:bff": "pnpm --filter ./bff typecheck",
    "typecheck:e2e": "tsc -p tests/e2e",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@craftainer/crud-sdk": "0.10.0",
    "@craftainer/crud-views": "0.8.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-charts": "9.18.1",
    "@mui/x-data-grid": "9.18.0",
    "@tanstack/react-query": "5.108.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "30.1.3",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
